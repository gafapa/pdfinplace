{
  "name": "PDF in Place",
  "short_name": "PDF in Place",
  "description": "Edit, organize, protect and export PDF documents entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f9fafb",
