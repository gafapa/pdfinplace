{
  "name": "pdfinplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run pdfjs:sync && vite",
    "build": "npm run pdfjs:sync && tsc -b && vite build && npm run pdfjs:check-dist",
    "stage:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-static-site.ps1 -Environment production",
    "lint": "biome lint .",
    "check:sw": "node --check public/sw.js",
    "pdfjs:sync": "node scripts/pdfjs-resources.mjs sync",
    "pdfjs:check": "node scripts/pdfjs-resources.mjs check",
    "pdfjs:check-dist": "node scripts/pdfjs-resources.mjs check-dist",
    "test:pdfjs-resources": "node scripts/pdfjs-resources.mjs self-test",
    "test": "vitest run",
    "test:browser": "node scripts/verify-editor-ui.mjs",
    "test:browser:all": "node scripts/run-browser-checks.mjs",
    "test:workbench": "node scripts/verify-workbench.mjs",
    "test:office": "node scripts/verify-office-import.mjs",
    "test:import-security": "node scripts/verify-import-security.mjs",
    "test:share-target": "node scripts/verify-share-target.mjs",
    "test:legal": "node scripts/verify-legal-pages.mjs",
    "test:tools": "node scripts/verify-pdf-tools.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libpdf/core": "^0.5.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "docx-preview": "^0.4.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.66.0",
    "pako": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@napi-rs/canvas": "^1.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
